{
  "name": "mobile-automation-framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "android:local": "wdio run ./config/wdio.android.local.conf.js",
    "ios:local": "wdio run ./config/wdio.ios.local.conf.js",
    "android:bstack": "wdio run ./config/wdio.android.bstack.conf.js",
    "ios:bstack": "wdio run ./config/wdio.ios.bstack.conf.js",
    "bstack:all": "concurrently -n ANDROID,IOS -c blue,magenta \"npm run android:bstack\" \"npm run ios:bstack\"",
    "android:smoke": "wdio run ./config/wdio.android.local.conf.js --suite androidSmoke",
    "android:sanity": "wdio run ./config/wdio.android.local.conf.js --suite androidSanity",
    "android:regression": "wdio run ./config/wdio.android.local.conf.js --suite androidRegression",
    "ios:smoke": "wdio run ./config/wdio.ios.local.conf.js --suite iosSmoke",
    "ios:sanity": "wdio run ./config/wdio.ios.local.conf.js --suite iosSanity",
    "ios:regression": "wdio run ./config/wdio.ios.local.conf.js --suite iosRegression",
    "report:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "report:open": "allure open reports/allure-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.31.4",
    "@wdio/appium-service": "^9.31.9",
    "@wdio/browserstack-service": "^9.36.0",
    "@wdio/cli": "^9.31.9",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/mocha-framework": "^9.31.9",
    "@wdio/spec-reporter": "^9.31.2",
    "allure-commandline": "^2.43.0",
    "appium": "^3.7.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "appium-xcuitest-driver": "^12.12.4",
    "concurrently": "^10.0.5",
    "deepmerge-ts": "^8.0.2",
    "dotenv": "^17.4.2"
  }
}
